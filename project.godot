[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="pickups"

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=3

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

limits/global_shader_variables/buffer_size=524288

anti_aliasing/quality/msaa_3d=2

[shader_globals]

corruption_map={
"type": "sampler2D",
"value": ""
}
corruption_params={
"type": "vec4",
"value": Vector4(100, 14, 32, 0.375)
}
corruption_origin={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
corruption_ambient={
"type": "float",
"value": 0.0
}
corruption_quality={
"type": "float",
"value": 2.0
}
atmo_cloud_strength={
"type": "float",
"value": 0.5
}
atmo_cloud_cover={
"type": "float",
"value": 0.5
}
atmo_cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
