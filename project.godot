; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SINBOUND"
run/main_scene="res://scenes/menu/demon_select.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://autoload/game.gd"
Maps="*res://autoload/maps.gd"
RunState="*res://autoload/run_state.gd"
Meta="*res://autoload/meta.gd"
Progression="*res://autoload/progression.gd"
Sfx="*res://autoload/sfx.gd"
MusicManager="*res://autoload/music_manager.gd"
Settings="*res://autoload/settings.gd"
Perf="*res://autoload/perf.gd"
Corruption="*res://autoload/corruption.gd"
Dialogue="*res://autoload/dialogue.gd"
Atmosphere="*res://autoload/atmosphere_director.gd"
Abilities="*res://autoload/abilities.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme.tres"

